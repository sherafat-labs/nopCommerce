# Database Configuration
POSTGRES_DB=nopcommerce
POSTGRES_USER=nopcommerce_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_HOST=nopcommerce_database
POSTGRES_PORT=5432

# Application Configuration
NOP_COMMERCE_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
NOP_FORWARDED_PROTO_HEADER=X-Forwarded-Proto

# Docker Network
DOCKER_NETWORK=nopnetwork

# Volume Names
POSTGRES_VOLUME=postgres_data

POSTGRES_VERSION=16
 

# Email Configuration for Postfix
MAIL_DOMAIN=stoneb2b.ir
EMAIL_FROM=noreply@stoneb2b.ir
EMAIL_DISPLAY_NAME=Stone B2B
SMTP_USERNAME=admin
SMTP_PASSWORD=your_secure_password_here

# Optional: If you need to relay through another SMTP server
# RELAY_HOST=[smtp.yourisp.com]:587